{
  "dashboard": {
    "id": null,
    "uid": "alb-observability-dashboard",
    "title": "ALB Observability Dashboard",
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "templating": {
      "list": [
        {
          "name": "loadBalancer",
          "type": "query",
          "datasource": "CloudWatch",
          "refresh": 1,
          "hide": 0,
          "label": "Load Balancer",
          "options": [],
          "query": "SELECT DISTINCT LoadBalancer FROM AWS/ApplicationELB WHERE metric_name = 'RequestCount' AND region = '${__sys.google.region}'",
          "refreshOnLoad": true,
          "multi": false,
          "includeAll": true,
          "allValue": ".+",
          "sort": 1,
          "default": ".+",
          "refreshOnLoad": true
        },
        {
          "name": "targetGroup",
          "type": "query",
          "datasource": "CloudWatch",
          "refresh": 1,
          "hide": 0,
          "label": "Target Group",
          "options": [],
          "query": "SELECT DISTINCT TargetGroup FROM AWS/ApplicationELB WHERE metric_name = 'RequestCount' AND LoadBalancer = '${loadBalancer}' AND region = '${__sys.google.region}'",
          "refreshOnLoad": true,
          "multi": false,
          "includeAll": true,
          "allValue": ".+",
          "sort": 1,
          "default": ".+"
        }
      ]
    },
    "panels": [
      {
        "type": "timeseries",
        "title": "Request Count (Total)",
        "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
        "datasource": "CloudWatch",
        "targets": [
          {
            "refId": "A",
            "region": "${__sys.google.region}",
            "metricName": "RequestCount",
            "namespace": "AWS/ApplicationELB",
            "dimensions": [
              { "name": "LoadBalancer", "value": "${loadBalancer}" },
              { "name": "TargetGroup", "value": "${targetGroup}" }
            ],
            "statistic": "Sum",
            "period": "",
            "interval": "",
            "expressions": [],
            "legendFormat": "{{TargetGroup}}",
            "rawSql": "",
            "hide": false,
            "intervalFactor": 1,
            "maxDataPoints": 43200,
            "timeout": null
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0,
            "custom": {}
          },
          "overrides": []
        },
        "options": {
          "legend": { "displayMode": "list", "placement": "bottom" },
          "tooltip": { "mode": "single" },
          "drawStyle": "line",
          "lineInterpolation": "linear",
          "lineWidth": 2,
          "pointSize": 5,
          "showPoints": "auto",
          "fillOpacity": 10,
          "gradientMode": "none",
          "spanNulls": false,
          "stacking": { "mode": "none", "group": "A" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0 }
            ]
          }
        }
      },
