            "dimensions": [
              { "name": "LoadBalancer", "value": "${loadBalancer}" },
              { "name": "TargetGroup", "value": "${targetGroup}" }
            ],
            "statistic": "Sum",
            "period": "",
            "interval": "",
            "expressions": [
              {
                "id": "B",
                "expression": "PERIOD_SECONDS(A, $interval)",
